+<Project Sdk="Microsoft.NET.Sdk">
+  <!-- Engine comparison (engcmp/kld-rows): logits rows of a llama.cpp `_logits_` base's chunks for
+       infernix-certify llama-rows. The direct-CUDA route only: no GGML or MLX native library. -->
+  <PropertyGroup>
+    <OutputType>Exe</OutputType>
+    <TargetFramework>net10.0</TargetFramework>
+    <ImplicitUsings>enable</ImplicitUsings>
+    <Nullable>enable</Nullable>
+    <TensorSharpSkipGgmlNative>true</TensorSharpSkipGgmlNative>
+    <TensorSharpSkipMlxNative>true</TensorSharpSkipMlxNative>
+  </PropertyGroup>
+  <ItemGroup>
+    <ProjectReference Include="../../TensorSharp.Models/TensorSharp.Models.csproj" />
+  </ItemGroup>
+</Project>
diff --git a/eng/KldRows/Program.cs b/eng/KldRows/Program.cs
new file mode 100644
index 00000000..73895c6f
--- /dev/null
+++ b/eng/KldRows/Program.cs
@@ -0,0 +1,109 @@
+// Engine comparison (engcmp/kld-rows): TensorSharp's logits on the chunks of a llama.cpp `_logits_` base file,
+// streamed to standard output for infernix-certify llama-rows: rows n_ctx/2 .. n_ctx-2 of every chunk, in base order,
+// binary32, the base's vocabulary wide.
+//
+//   KldRows MODEL BASE --mode prompt|decode [--chunks N]
+//
+// prompt: each chunk is one prompt forward (the prompt path); the scored rows go through the model's own final norm
+//         and LM head (Qwen35CudaModel.ForwardPromptRows; the forward computes only its last row's logits otherwise).
+// decode: tokens 0 .. n_ctx/2 are one prompt (its last row is the first scored row); the rest goes through the calls
+//         TensorSharp's speculative loop makes (SpeculativeExecution.Step): DraftBlock drafts K tokens after the
+//         current token, SpecForward verifies the window [token, d1..dK] with every row's logits, and
+//         SpecOnVerifyAccepted commits the token and the accepted drafts. The text's tokens are forced: a draft is
+//         accepted while it equals the text's next token, and each position's row is the one of the window that
+//         commits it (rows past the first rejected draft are recomputed by the next window).
+using System.Runtime.InteropServices;
+using TensorSharp;
+using TensorSharp.Models;
+using TensorSharp.Runtime;
+
+if (args.Length < 2)
+{
+    Console.Error.WriteLine("usage: KldRows MODEL BASE --mode prompt|decode [--chunks N]");
+    return 2;
+}
+// Standard output carries the binary rows only: the library's console text (its "Model: ..." line) goes to stderr.
+var output = Console.OpenStandardOutput();
+Console.SetOut(Console.Error);
+string modelPath = args[0], basePath = args[1];
+string mode = Option("--mode") ?? "prompt";
+if (mode != "prompt" && mode != "decode") throw new ArgumentException("--mode prompt|decode");
+int chunksWanted = int.Parse(Option("--chunks") ?? "0");
+
+using var file = File.OpenRead(basePath);
+var magic = new byte[8];
+file.ReadExactly(magic);
+if (System.Text.Encoding.ASCII.GetString(magic) != "_logits_") throw new InvalidDataException(basePath + " is not a _logits_ file");
+var head = new int[3];
+file.ReadExactly(MemoryMarshal.AsBytes(head.AsSpan()));
+int context = head[0], vocab = head[1], baseChunks = head[2];
+var tokens = new int[(long)context * baseChunks];
+file.ReadExactly(MemoryMarshal.AsBytes(tokens.AsSpan()));
+int chunks = chunksWanted == 0 ? baseChunks : Math.Min(chunksWanted, baseChunks);
+int first = context / 2, rows = context - 1 - first;
+
+KvCacheDtypeConfig.ConfigureFromEnvironment();
+using var model = ModelBase.Create(modelPath, BackendType.Cuda);
+var q35 = model as Qwen35CudaModel ?? throw new NotSupportedException($"{modelPath}: not the direct-CUDA Qwen3.5/3.8 model");
+if (model.Config.VocabSize != vocab)
+    throw new InvalidDataException($"the model's head has {model.Config.VocabSize} rows; the base's vocabulary is {vocab}");
+int k = mode == "decode" ? q35.SpecMaxDraftTokens : 0;
+if (mode == "decode" && k < 1) throw new InvalidOperationException("decode needs the drafter (TS_Q35_NINFER_DRAFT_PTX)");
+Console.Error.WriteLine($"kld-rows: {mode}, {chunks} chunks of {context}, rows {first}..{context - 2}, vocabulary {vocab}" +
+    (k > 0 ? $", {k} drafts per window" : ""));
+
+var rowsOut =new float[(long)rows * vocab];
+var window = new float[(long)(k + 1) * vocab];
+var drafts = new int[Math.Max(k, 1)];
+var confidence = new float[Math.Max(k, 1)];
+long drafted = 0, accepted = 0, windows = 0;
+for (int c = 0; c < chunks; c++)
+{
+    int[] chunk = tokens.AsSpan(c * context, context).ToArray();
+    model.ResetKVCache();
+    if (mode == "prompt")
+        q35.ForwardPromptRows(chunk, first, rows, rowsOut);
+    else
+    {
+        float[] last = model.ForwardPrompt(chunk[..(first + 1)]);
+        Array.Copy(last, 0, rowsOut, 0, vocab);
+        int position = first + 1;   // committed tokens; chunk[position] is the next token in
+        while (position <= context - 2)
+        {
+            int token = chunk[position];
+            int kMax = Math.Min(k, context - 2 - position);   // rows past n_ctx - 2 are not scored
+            int n = kMax > 0 ? Math.Min(q35.DraftBlock(token, null, position, drafts, confidence), kMax) : 0;
+            if (n == 0)
+            {
+                q35.SpecForward(new[] { token }, null, window, allLogitsRows: false);
+                Array.Copy(window, 0, rowsOut, (long)(position - first) * vocab, vocab);
+                position++;
+                continue;
+            }
+            var batch = new int[n + 1];
+            batch[0] = token;
+            Array.Copy(drafts, 0, batch, 1, n);
+            q35.SpecForward(batch, null, window, allLogitsRows: true);
+            int m = 0;
+            while (m < n && drafts[m] == chunk[position + 1 + m]) m++;
+            Array.Copy(window, 0, rowsOut, (long)(position - first) * vocab, (long)(m + 1) * vocab);
+            q35.SpecOnVerifyAccepted(m, n);
+            position += m + 1;
+            drafted += n;
+            accepted += m;
+            windows++;
+        }
+    }
+    output.Write(MemoryMarshal.AsBytes(rowsOut.AsSpan()));
+    output.Flush();
+    if ((c + 1) % 20 == 0 || c + 1 == chunks)
+        Console.Error.WriteLine($"kld-rows: {c + 1}/{chunks} chunks" +
+            (windows > 0 ? $", {windows} windows, {accepted} of {drafted} drafts accepted" : ""));
+}
+return 0;
+
+string? Option(string name)
+{
+    int at = Array.IndexOf(args, name);
+    return at < 0 ? null : at + 1 < args.Length ? args[at + 1] : throw new ArgumentException("missing " + name);
+}
