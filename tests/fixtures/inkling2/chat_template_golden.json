{
 "source": "transformers 5.21.0.dev0 apply_chat_template",
 "cases": [
  {
   "name": "user only",
   "context": {
    "messages": [
     {
      "role": "user",
      "content": "Hello!"
     }
    ]
   },
   "expected": "<|message_system|><|content_text|>Thinking effort level: 0.9<|end_message|><|message_user|><|content_text|>Hello!<|end_message|>"
  },
  {
   "name": "system and user",
   "context": {
    "messages": [
     {
      "role": "system",
      "content": "You are terse."
     },
     {
      "role": "user",
      "content": "What is 2+2?"
     }
    ]
   },
   "expected": "<|message_system|><|content_text|>You are terse.<|end_message|><|message_system|><|content_text|>Thinking effort level: 0.9<|end_message|><|message_user|><|content_text|>What is 2+2?<|end_message|>"
  },
  {
   "name": "effort string",
   "context": {
    "messages": [
     {
      "role": "user",
      "content": "Plan a trip."
     }
    ],
    "reasoning_effort": "low"
   },
   "expected": "<|message_system|><|content_text|>Thinking effort level: 0.2<|end_message|><|message_user|><|content_text|>Plan a trip.<|end_message|>"
  },
  {
   "name": "effort none",
