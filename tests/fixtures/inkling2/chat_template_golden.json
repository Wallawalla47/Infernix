    "messages": [
     {
      "role": "user",
      "content": "Hi"
     }
    ],
    "reasoning_effort": "none"
   },
   "expected": "<|message_system|><|content_text|>Thinking effort level: 0<|end_message|><|message_user|><|content_text|>Hi<|end_message|>"
