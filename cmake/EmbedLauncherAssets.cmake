# Writes OUT, a C++ source holding the launcher's web UI (UI, gzip-compressed HTML; empty when the
# file is absent) and download catalog (CATALOG) as byte arrays. Run with cmake -P.

function(embed_bytes input name out_var)
  if(EXISTS "${input}")
    file(READ "${input}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # Break the initializer into lines of 32 bytes.
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n  " bytes "${bytes}")
  else()
    set(size 0)
    set(bytes "0x00,")
  endif()
  set(${out_var}
      "extern const unsigned char ${name}[] = {\n  ${bytes}\n};\nextern const std::size_t ${name}Size = ${size};\n"
      PARENT_SCOPE)
endfunction()

embed_bytes("${UI}" kUiGzip ui_source)
embed_bytes("${CATALOG}" kCatalogJson catalog_source)
set(content "// Generated by cmake/EmbedLauncherAssets.cmake -- do not edit.\n#include \"launcher/assets.h\"\n\nnamespace infernix::launcher::assets {\n\n${ui_source}\n${catalog_source}\n} // namespace infernix::launcher::assets\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" previous)
  if(previous STREQUAL content)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${content}")
